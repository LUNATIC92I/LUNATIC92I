# LUNATIC-IT SIEM — local development environment template.
# Copy to `.env` and adjust. NEVER commit `.env`. These defaults are for
# local Docker Compose development ONLY and are not fit for any shared or
# production environment.

ENV=development
LOG_LEVEL=INFO

# --- Backend API ---
BACKEND_PORT=8000
JWT_SECRET_KEY=dev-only-change-me-do-not-use-in-production
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- PostgreSQL ---
POSTGRES_USER=lunatic
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=lunatic_siem
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lunatic:dev-only-change-me@postgres:5432/lunatic_siem

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Dev-Only-Change-Me-1!

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-only-change-me
