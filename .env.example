# LUNATIC-IT SIEM — local development environment template.
# Copy to `.env` and adjust. NEVER commit `.env`. These defaults are for
# local Docker Compose development ONLY and are not fit for any shared or
# production environment.

ENV=development
LOG_LEVEL=INFO

# --- Backend API ---
BACKEND_PORT=8000
# The frontend authenticates with an httpOnly refresh cookie, so its origin
# must be named explicitly (comma-separated for more than one) — empty
# means no browser origin is allowed at all, fail closed like the egress
# guard. A wildcard is both rejected by browsers for credentialed requests
# and a much wider hole than this API needs.
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=dev-only-change-me-do-not-use-in-production
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# Fernet key used to envelope-encrypt MFA TOTP secrets at rest — generate
# your own with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=dev-only-generate-a-real-fernet-key-see-comment-above

# Brute-force lockout (THREAT_MODEL.md §3.3)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
# Per-IP rate limits on the auth endpoints (Phase 17, OWASP ASVS V2.2.1) —
# a second, independent control on top of lockout above: lockout alone
# does nothing about a low-and-slow spray across many accounts, or a flood
# of organization registrations, from one source.
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=10
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=60

# --- PostgreSQL ---
POSTGRES_USER=lunatic
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=lunatic_siem
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lunatic:dev-only-change-me@postgres:5432/lunatic_siem

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Dev-Only-Change-Me-1!
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Dev-Only-Change-Me-1!
# MUST be true in production. False only tolerates the self-signed demo
# certificates a local cluster ships with — an unverified TLS connection to
# the event store is a silent MITM opportunity for everything the SOC sees.
OPENSEARCH_VERIFY_CERTS=false

# Retention per index family, in days. A compliance decision, not an
# engineering one — set these to whatever the tenant's policy requires.
OPENSEARCH_RAW_RETENTION_DAYS=90
OPENSEARCH_NORMALIZED_RETENTION_DAYS=180
OPENSEARCH_DEADLETTER_RETENTION_DAYS=90

# --- Ingestion (Phase 3) ---
INGEST_MAX_PAYLOAD_BYTES=1048576
INGEST_RATE_LIMIT_PER_MINUTE=60000
# How long a collector retry is recognized as a duplicate. Not a
# uniqueness guarantee for all time — see app/services/ingestion.py.
INGEST_DEDUP_TTL_SECONDS=3600

# Syslog collector worker (docker compose --profile syslog up).
# BOTH are required: syslog is unauthenticated, so a listener is pinned to
# one tenant and an explicit source allowlist. An empty allowlist accepts
# nothing — that is deliberate, not a placeholder to leave blank.
SYSLOG_TENANT_ID=
SYSLOG_ALLOWED_SOURCE_CIDRS=
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5515

# --- Detection engine (Phase 6) ---
# Where the shipped rule pack is read from. In compose this is the
# repository's rules/ directory, mounted read-only.
DETECTION_RULES_PATH=/app/rules
# How often each worker re-reads its tenants' rules from PostgreSQL, so
# enabling or disabling a rule takes effect without a restart.
DETECTION_RULE_REFRESH_SECONDS=60
# How often windowed (threshold) rules are evaluated. Keep it shorter than
# the shortest rule window: runs overlap on purpose so an attack straddling
# two runs still lands whole inside one window.
DETECTION_WINDOW_INTERVAL_SECONDS=60

# --- Correlation engine (Phase 7) ---
# How far a source's own timestamp may sit from its ingestion time before
# the correlation engine stops believing it and uses ingestion time instead.
# Wide enough for ordinary clock drift and collector lag, narrow enough that
# a forged timestamp cannot step a stage outside a correlation window.
CORRELATION_MAX_CLOCK_SKEW_SECONDS=900

# --- Outbound egress guard (Phase 9, THREAT_MODEL.md §3.8) ---
# Comma-separated hosts the platform may fetch from (threat-intel feeds now,
# playbook webhooks later). EMPTY MEANS NOTHING IS REACHABLE: the guard
# fails closed. A leading dot matches subdomains (".example.com").
EGRESS_ALLOWED_HOSTS=
# Both of these are LOCAL DEVELOPMENT ONLY and must stay false in any real
# deployment. The first permits plain HTTP (an on-path attacker then chooses
# what your threat intelligence says); the second disables the check that
# refuses hosts resolving to loopback, private or link-local addresses —
# i.e. it disables the SSRF protection itself.
EGRESS_ALLOW_HTTP=false
EGRESS_ALLOW_PRIVATE_DESTINATIONS=false

# --- Threat intelligence (Phase 9) ---
THREAT_INTEL_FEED_INTERVAL_SECONDS=3600
# Indicators from a feed expire after this many days unless the feed states
# its own expiry. Intel is perishable; without a TTL the platform
# accumulates claims nobody stands behind any more.
THREAT_INTEL_DEFAULT_TTL_DAYS=30
# Directory file-drop feeds read from. Feed filenames are confined to it.
THREAT_INTEL_DROP_DIR=/app/intel-drop

# --- MITRE ATT&CK (Phase 10) ---
# Where the ATT&CK STIX bundle is imported from: an HTTPS URL (subject to
# EGRESS_ALLOWED_HOSTS — add raw.githubusercontent.com to fetch the official
# bundle) or a filename in THREAT_INTEL_DROP_DIR for air-gapped installs.
MITRE_ATTACK_SOURCE=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json
# The catalog is re-imported by the feeds worker once it is older than this,
# and the coverage page flags it as stale. ATT&CK ships several revisions a
# year; coverage measured against last year's matrix measures the wrong thing.
MITRE_CATALOG_MAX_AGE_DAYS=90

# --- SOAR playbooks (Phase 15) ---
# Where the shipped playbook pack is read from — the repository's
# playbooks/ directory, mounted read-only, same pattern as
# DETECTION_RULES_PATH above.
PLAYBOOKS_PATH=/app/playbooks

# --- Alerts (Phase 11) ---
# How long a repeat of the same thing folds into the open alert instead of
# raising a new one. Sixty brute-force firings against one account are one
# alert with sixty occurrences, not sixty alerts.
ALERT_DEDUP_WINDOW_MINUTES=60
# Detections below this risk score are recorded and searchable but do not
# become an analyst's task. Where that line sits is a SOC staffing decision.
ALERT_MIN_RISK_SCORE=0

# --- Threat hunting (Phase 13) ---
# Page size cap for an interactive search/pivot result set.
HUNT_SEARCH_MAX_RESULTS=1000
# Row cap for a single export — a bulk download is a different risk from a
# result an analyst pages through (THREAT_MODEL.md §3.7).
HUNT_EXPORT_MAX_ROWS=10000
# Exports are rate-limited per tenant in addition to being audit-logged
# (EXPORT_DATA): a legitimate hunting feature is also a data-exfiltration
# path if the bulk-download action itself goes unwatched.
HUNT_EXPORT_RATE_LIMIT_PER_HOUR=20

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Observability (Phase 16) ---
# `/health`, `/ready` and `/metrics` for every worker process (and, for
# `/metrics` only, the API too — see docs/OBSERVABILITY.md) live on this
# port. Never published in docker-compose.yml's `ports:`: only Prometheus,
# over the internal `app` network, ever reaches it.
METRICS_PORT=9100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-only-change-me
# OTLP/HTTP endpoint traces are exported to (e.g. a local Jaeger/Tempo
# collector's http://otel-collector:4318/v1/traces). Empty by default:
# spans are still created and propagated across the pipeline, but nothing
# leaves the process — the same fail-closed-until-configured shape as
# EGRESS_ALLOWED_HOSTS.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lunatic-siem-backend
